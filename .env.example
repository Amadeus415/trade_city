# Copy to .env and fill in. Never commit .env.

# LLM provider: openai | anthropic | xai | ollama | mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_ANALYST_MODEL=
LLM_PM_MODEL=

# Optional bar data provider (yfinance is free default for research)
BAR_PROVIDER=yfinance
POLYGON_API_KEY=
ALPHAVANTAGE_API_KEY=

# Alert webhook (optional — risk transitions, stuck orders, etc.)
ALERT_WEBHOOK_URL=

# Paths (defaults are fine for local use)
FUND_DATA_DIR=./data
FUND_CONFIG_DIR=./config
